{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "welcome-sksap",
  "compatibility_date": "2026-09-14",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "WISHES_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "routes": [
    {
      "pattern": "welcome.sksap.com",
      "custom_domain": true
    }
  ]
}
